{% doc %}
Renders the primary navigation.
{% enddoc %}
{%- liquid
  assign navigation_journal = blogs.news
  assign add_journal = false
  if navigation_journal.articles_count > 0
    assign add_journal = true
    for navigation_item in section.settings.menu.links
      if navigation_item.url == navigation_journal.url
        assign add_journal = false
      endif
    endfor
  endif
-%}


<nav class="header__inline-menu">
  <ul class="list-menu list-menu--inline" role="list">
    {%- for link in section.settings.menu.links -%}
      {%- liquid
        assign menu_title = link.title
        assign menu_url = link.url
        assign menu_current = link.current
        assign is_home = false
        if link.type == 'frontpage_link' or link.url == routes.root_url
          assign is_home = true
          assign menu_url = routes.root_url
          assign menu_current = false
          if request.page_type == 'index'
            assign menu_current = true
          endif
        endif
        if link.type == 'catalog_link' or link.handle == 'catalog'
          assign menu_title = 'tavia_navigation.shop' | t
        endif
      -%}
      {%- if add_journal and link.url contains '/pages/contact' -%}
        {% render 'tavia-journal-navigation', journal: navigation_journal, layout: 'desktop' %}
        {%- assign add_journal = false -%}
      {%- endif -%}

      <li>
        {%- if link.links != blank and is_home == false -%}
          <header-menu>
            <details id="Details-HeaderMenu-{{ forloop.index }}">
              <summary
                id="HeaderMenu-{{ link.handle }}"
                class="header__menu-item list-menu__item link focus-inset"
              >
                <span
                  {%- if link.child_active %}
                    class="header__active-menu-item"
                  {% endif %}
                >
                  {{- menu_title | escape -}}
                </span>
                {{- 'icon-caret.svg' | inline_asset_content -}}
              </summary>
              <ul
                id="HeaderMenu-MenuList-{{ forloop.index }}"
                class="header__submenu list-menu list-menu--disclosure color-{{ section.settings.menu_color_scheme }} gradient caption-large motion-reduce global-settings-popup"
                role="list"
                tabindex="-1"
              >
                {%- for childlink in link.links -%}
                  <li>
                    {%- if childlink.links == blank -%}
                      <a
                        id="HeaderMenu-{{ link.handle }}-{{ childlink.handle }}"
                        href="{{ childlink.url }}"
                        class="header__menu-item list-menu__item link link--text focus-inset caption-large{% if childlink.current %} list-menu__item--active{% endif %}"
                        {% if childlink.current %}
                          aria-current="page"
                        {% endif %}
                      >
                        {{ childlink.title | escape }}
                      </a>
                    {%- else -%}
                      <details id="Details-HeaderSubMenu-{{ link.handle }}-{{ childlink.handle }}">
                        <summary
                          id="HeaderMenu-{{ link.handle }}-{{ childlink.handle }}"
                          class="header__menu-item link link--text list-menu__item focus-inset caption-large"
                        >
                          <span>{{ childlink.title | escape }}</span>
                          {{- 'icon-caret.svg' | inline_asset_content -}}
                        </summary>
                        <ul
                          id="HeaderMenu-SubMenuList-{{ link.handle }}-{{ childlink.handle }}"
                          class="header__submenu list-menu motion-reduce"
                        >
                          {%- for grandchildlink in childlink.links -%}
                            <li>
                              <a
                                id="HeaderMenu-{{ link.handle }}-{{ childlink.handle }}-{{ grandchildlink.handle }}"
                                href="{{ grandchildlink.url }}"
                                class="header__menu-item list-menu__item link link--text focus-inset caption-large{% if grandchildlink.current %} list-menu__item--active{% endif %}"
                                {% if grandchildlink.current %}
                                  aria-current="page"
                                {% endif %}
                              >
                                {{ grandchildlink.title | escape }}
                              </a>
                            </li>
                          {%- endfor -%}
                        </ul>
                      </details>
                    {%- endif -%}
                  </li>
                {%- endfor -%}
              </ul>
            </details>
          </header-menu>
        {%- else -%}
          <a
            id="HeaderMenu-{{ link.handle }}"
            href="{{ menu_url }}"
            class="header__menu-item list-menu__item link link--text focus-inset"
            {% if menu_current %}
              aria-current="page"
            {% endif %}
          >
            <span
              {%- if menu_current %}
                class="header__active-menu-item"
              {% endif %}
            >
              {{- menu_title | escape -}}
            </span>
          </a>
        {%- endif -%}
      </li>
    {%- endfor -%}
    {%- if add_journal -%}{% render 'tavia-journal-navigation', journal: navigation_journal, layout: 'desktop' %}{%- endif -%}
  </ul>
</nav>
