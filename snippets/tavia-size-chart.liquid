{% doc %}
  Renders the shared footwear size chart and measuring instructions.
  @param {product} product - Product whose sizes are shown.
{% enddoc %}
{% liquid
  assign chart_sizes = '' | split: ','
  for option in product.options_with_values
    assign name = option.name | downcase
    if name contains 'size' or name contains '尺码' or name contains '尺寸'
      assign chart_sizes = option.values | map: 'name'
      break
    endif
  endfor
%}
<tavia-size-chart
  data-sizes="{{ chart_sizes | json | escape }}"
  data-heading-cm="{{ 'tavia_size_chart.length_cm' | t | escape }}"
  data-heading-in="{{ 'tavia_size_chart.length_in' | t | escape }}"
>
  <header class="tavia-size-chart__header"><h2>{{ 'tavia_size_chart.title' | t }}</h2></header>
  <div class="tavia-size-chart__body">
    <p>{{ 'tavia_size_chart.intro' | t }}</p>
    <div class="tavia-size-chart__units" role="group" aria-label="{{ 'tavia_size_chart.units' | t }}">
      <button type="button" data-chart-unit="cm" aria-pressed="true">{{ 'tavia_size_chart.cm' | t }}</button>
      <button type="button" data-chart-unit="in" aria-pressed="false">{{ 'tavia_size_chart.inch' | t }}</button>
    </div>
    <div data-chart-table class="tavia-size-chart__table-wrap">
      <table>
        <caption class="visually-hidden">{{ 'tavia_size_chart.title' | t }}</caption>
        <thead><tr>
          <th scope="col">{{ 'tavia_size_chart.women' | t }}</th>
          <th scope="col">{{ 'tavia_size_chart.men' | t }}</th>
          <th scope="col" data-length-heading aria-live="polite">{{ 'tavia_size_chart.length_cm' | t }}</th>
          <th scope="col">{{ 'tavia_size_chart.eu' | t }}</th>
        </tr></thead>
        <tbody></tbody>
      </table>
    </div>
    <p data-chart-empty hidden>{{ 'tavia_size_chart.empty' | t }}</p>
    <noscript><p>{{ 'tavia_size_chart.no_js' | t }}</p></noscript>
    <div class="tavia-size-chart__measure">
      <h3>{{ 'tavia_size_chart.measure' | t }}</h3>
      <ol>
        <li>{{ 'tavia_size_chart.step_1' | t }}</li>
        <li>{{ 'tavia_size_chart.step_2' | t }}</li>
        <li>{{ 'tavia_size_chart.step_3' | t }}</li>
        <li>{{ 'tavia_size_chart.step_4' | t }}</li>
      </ol>
      <p>{{ 'tavia_size_chart.tip' | t }}</p>
    </div>
  </div>
</tavia-size-chart>
{% stylesheet %}
.tavia-size-modal .product-popup-modal__content {
  width: min(88vw, 88rem); max-width: calc(100vw - 3.2rem); height: auto; max-height: 88vh; max-height: 88dvh;
  margin: 6vh auto; padding: 0; border: 1px solid #dedede; background: #fff; color: #191919;
}
.tavia-size-modal .product-popup-modal__toggle {
  position: sticky; top: 1.2rem; float: right; right: 1.2rem; margin: 1.2rem 1.2rem -5.6rem 0;
  z-index: 3; background: #fff; color: #191919; width: 4.4rem; height: 4.4rem; border: 0;
}
tavia-size-chart { display: block; font-family: var(--font-body-family); font-size: 1.4rem; line-height: 1.6; letter-spacing: 0; }
tavia-size-chart [hidden] { display: none !important; }
.tavia-size-chart__header { position: sticky; top: 0; z-index: 2; background: #fff; padding: 2rem 7rem 2rem 2.4rem; border-bottom: 1px solid #e4e4e4; }
.tavia-size-chart__header h2 { margin: 0; font-family: var(--font-heading-family); font-size: 2.4rem; font-weight: 500; letter-spacing: -.02em; line-height: 1.3; }
.tavia-size-chart__body { padding: 2.4rem; }
.tavia-size-chart__body > p { margin: 0 0 2rem; }
.tavia-size-chart__units { display: flex; justify-content: center; gap: .4rem; margin-bottom: 1.6rem; }
.tavia-size-chart__units button { appearance: none; border: 1px solid #ddd; background: #f5f5f5; color: #191919; border-radius: 999px; padding: .8rem 2rem; min-height: 4.4rem; font: inherit; cursor: pointer; }
.tavia-size-chart__units button[aria-pressed='true'] { background: #191919; color: #fff; border-color: #191919; }
.tavia-size-chart__units button:focus-visible { outline: 2px solid #191919; outline-offset: 3px; }
.tavia-size-chart__table-wrap { overflow-x: auto; }
.tavia-size-modal .tavia-size-chart__table-wrap table { display: table; max-width: none; white-space: normal; margin: 0; width: 100%; border-collapse: collapse; table-layout: fixed; box-shadow: none; font-size: 1.4rem; }
.tavia-size-chart__table-wrap th, .tavia-size-chart__table-wrap td { text-align: center; border: 1px solid #fff; padding: 1.1rem .6rem; font-weight: 400; font-variant-numeric: tabular-nums; }
.tavia-size-chart__table-wrap thead th { background: #e9e9eb; font-weight: 500; line-height: 1.4; }
.tavia-size-chart__table-wrap th:nth-child(3) { width: 37%; }
.tavia-size-chart__table-wrap tbody tr:nth-child(even) { background: #f0f0f1; }
.tavia-size-chart__table-wrap tbody tr:nth-child(odd) { background: #fafafa; }
.tavia-size-chart__measure { margin-top: 2.8rem; }
.tavia-size-chart__measure h3 { font-family: var(--font-body-family); font-size: 1.6rem; font-weight: 500; }
.tavia-size-chart__measure ol { padding-left: 2rem; }
.tavia-size-chart__measure li { margin-block: .6rem; }
@media (max-width: 749px) {
  .tavia-size-modal .product-popup-modal__content { width: calc(100vw - 2.4rem); max-width: none; margin: 4vh auto; max-height: 92vh; max-height: 92dvh; }
  .tavia-size-chart__header { padding-left: 1.6rem; }
  .tavia-size-chart__header h2 { font-size: 2rem; }
  .tavia-size-chart__body { padding: 1.6rem; }
  .tavia-size-modal .tavia-size-chart__table-wrap table { font-size: 1.2rem; }
  .tavia-size-chart__table-wrap th, .tavia-size-chart__table-wrap td { padding: 1rem .4rem; }
}
{% endstylesheet %}
