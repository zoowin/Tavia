{% doc %}
Renders configurable product information and store policies in the buy box.
@param {object} product - Current product
@param {object} block - Section block
@param {string} section_id - Product section ID
{% enddoc %}

{%- liquid
  assign content = block.settings.content
  assign heading = block.settings.heading
  case block.type
    when 'product_intro'
      if content == blank and block.settings.use_description
        assign content = product.description | split: '</p>' | first | strip_html | strip | truncate: 180
      endif
  endcase
-%}

{%- if block.type == 'policy_summary' -%}
  {%- if block.settings.shipping_text != blank or block.settings.returns_text != blank -%}
    <div class="tavia-policy-summary" {{ block.shopify_attributes }}>
      {%- if block.settings.shipping_text != blank -%}
        <p>{% if shop.shipping_policy != blank %}<a href="{{ shop.shipping_policy.url }}">{% endif %}{{ block.settings.shipping_text | escape }}{% if shop.shipping_policy != blank %}</a>{% endif %}</p>
      {%- endif -%}
      {%- if block.settings.returns_text != blank -%}
        <p>{% if shop.refund_policy != blank %}<a href="{{ shop.refund_policy.url }}">{% endif %}{{ block.settings.returns_text | escape }}{% if shop.refund_policy != blank %}</a>{% endif %}</p>
      {%- endif -%}
    </div>
  {%- elsif request.design_mode -%}
    <p class="tavia-editor-note" {{ block.shopify_attributes }}>{{ 'tavia_pdp.policy_setup' | t }}</p>
  {%- endif -%}
{%- elsif block.type == 'product_intro' -%}
  {%- if content != blank -%}
    <div class="tavia-product-intro rte" {{ block.shopify_attributes }}>{{ content }}</div>
  {%- elsif request.design_mode -%}
    <p class="tavia-editor-note" {{ block.shopify_attributes }}>{{ 'tavia_pdp.intro_setup' | t }}</p>
  {%- endif -%}
{%- else -%}
  {%- assign panel_content = block.settings.content -%}
  {%- if panel_content != blank -%}
    <div class="product__accordion accordion tavia-buybox-panel" {{ block.shopify_attributes }}>
      <details id="Details-{{ block.id }}-{{ section_id }}" {% if block.settings.open_by_default %}open{% endif %}>
        <summary>
          <div class="summary__title"><h2 class="h4 accordion__title">{{ block.settings.heading | escape }}</h2></div>
          {{- 'icon-caret.svg' | inline_asset_content -}}
        </summary>
        <div class="accordion__content rte">{{ panel_content }}</div>
      </details>
    </div>
  {%- elsif request.design_mode -%}
    <p class="tavia-editor-note" {{ block.shopify_attributes }}>{{ heading | escape }} — {{ 'tavia_pdp.content_setup' | t }}</p>
  {%- endif -%}
{%- endif -%}
