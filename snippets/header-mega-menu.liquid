{% doc %}
  Renders the desktop navigation with editable collection image cards.
{% enddoc %}
{%- liquid
  assign navigation_journal = blogs.news
  assign add_journal = false
  if navigation_journal.articles_count > 0
    assign add_journal = true
    for navigation_item in section.settings.menu.links
      if navigation_item.url == navigation_journal.url
        assign add_journal = false
      endif
    endfor
  endif
-%}

{{ 'tavia-mega-menu.css' | asset_url | stylesheet_tag }}
{%- assign image_profiles = section.blocks | where: 'type', 'menu_collection' -%}
<nav class="header__inline-menu">
  <tavia-mega-menu-controller hidden></tavia-mega-menu-controller>
  <ul class="list-menu list-menu--inline" role="list">
    {%- for link in section.settings.menu.links -%}
      {%- liquid
        assign menu_title = link.title
        assign menu_url = link.url
        assign menu_current = link.current
        assign is_home = false
        if link.type == 'frontpage_link' or link.url == routes.root_url
          assign is_home = true
          assign menu_url = routes.root_url
          assign menu_current = false
          if request.page_type == 'index'
            assign menu_current = true
          endif
        endif
        assign dropdown_heading = link.title
        assign dropdown_label = ''
        assign dropdown_url = ''
        assign menu_group = nil
        if link.type == 'catalog_link' or link.handle == 'catalog' or link.handle == 'shop'
          assign dropdown_heading = section.settings.mega_menu_heading
          assign dropdown_label = section.settings.mega_menu_all_label
          assign dropdown_url = routes.all_products_collection_url
        endif
        assign normalized_menu_title = link.title | strip | downcase
        for group in section.blocks
          if group.type == 'mega_group'
            assign normalized_group_title = group.settings.title | strip | downcase
            if normalized_group_title != blank and normalized_group_title == normalized_menu_title
              assign dropdown_heading = group.settings.heading
              assign dropdown_label = group.settings.link_label
              assign dropdown_url = group.settings.link
              assign menu_group = group
              break
            endif
          endif
        endfor
        if link.type == 'catalog_link' or link.handle == 'catalog'
          assign menu_title = 'tavia_navigation.shop' | t
        endif
      -%}
      {%- if add_journal and link.url contains '/pages/contact' -%}
        {% render 'tavia-journal-navigation', journal: navigation_journal, layout: 'desktop' %}
        {%- assign add_journal = false -%}
      {%- endif -%}

      <li>
        {%- if link.links != blank and is_home == false -%}
          <header-menu>
            <details id="Details-HeaderMenu-{{ forloop.index }}" class="mega-menu{% if link.links.size == 1 %} tavia-mega-menu--single{% endif %}">
              <summary
                id="HeaderMenu-{{ link.handle }}"
                class="header__menu-item list-menu__item link focus-inset"
              >
                <span
                  {%- if link.child_active %}
                    class="header__active-menu-item"
                  {% endif %}
                >
                  {{- menu_title | escape -}}
                </span>
                {{- 'icon-caret.svg' | inline_asset_content -}}
              </summary>
              <div
                id="MegaMenu-Content-{{ forloop.index }}"
                class="mega-menu__content tavia-mega-menu__content color-{{ section.settings.menu_color_scheme }} gradient motion-reduce global-settings-popup"
                tabindex="-1"
              >
                {%- if dropdown_heading != blank or dropdown_label != blank and dropdown_url != blank -%}
                  <div class="tavia-mega-menu__topline page-width"{% if menu_group != blank %} {{ menu_group.shopify_attributes }}{% endif %}>
                    {%- if dropdown_heading != blank -%}<p class="tavia-mega-menu__heading">{{ dropdown_heading | escape }}</p>{%- endif -%}
                    {%- if dropdown_label != blank and dropdown_url != blank -%}
                      <a class="tavia-mega-menu__all" href="{{ dropdown_url }}">
                        {{ dropdown_label | escape }} <span aria-hidden="true">↗</span>
                      </a>
                    {%- endif -%}
                  </div>
                {%- endif -%}
                <ul
                  class="mega-menu__list tavia-mega-menu__grid page-width{% if link.links.size == 1 %} tavia-mega-menu__grid--single{% endif %}"
                  style="--tavia-menu-columns: {{ link.links.size | at_most: 5 }};"
                  role="list"
                >
                  {%- for childlink in link.links -%}
                    <li>
                      <a
                        id="HeaderMenu-{{ link.handle }}-{{ childlink.handle }}"
                        href="{{ childlink.url }}"
                        class="mega-menu__link mega-menu__link--level-2 tavia-mega-menu__card link{% if childlink.current %} mega-menu__link--active{% endif %}"
                        {% if childlink.current %}
                          aria-current="page"
                        {% endif %}
                      >
                        {% render 'tavia-menu-link-content', navigation_link: childlink, image_profiles: image_profiles, overview_image: section.settings.mega_menu_overview_image %}
                      </a>
                      {%- if childlink.links != blank -%}
                        <ul class="list-unstyled" role="list">
                          {%- for grandchildlink in childlink.links -%}
                            <li>
                              <a
                                id="HeaderMenu-{{ link.handle }}-{{ childlink.handle }}-{{ grandchildlink.handle }}"
                                href="{{ grandchildlink.url }}"
                                class="mega-menu__link link{% if grandchildlink.current %} mega-menu__link--active{% endif %}"
                                {% if grandchildlink.current %}
                                  aria-current="page"
                                {% endif %}
                              >
                                {{ grandchildlink.title | escape }}
                              </a>
                            </li>
                          {%- endfor -%}
                        </ul>
                      {%- endif -%}
                    </li>
                  {%- endfor -%}
                </ul>
              </div>
            </details>
          </header-menu>
        {%- else -%}
          <a
            id="HeaderMenu-{{ link.handle }}"
            href="{{ menu_url }}"
            class="header__menu-item list-menu__item link link--text focus-inset"
            {% if menu_current %}
              aria-current="page"
            {% endif %}
          >
            <span
              {%- if menu_current %}
                class="header__active-menu-item"
              {% endif %}
            >
              {{- menu_title | escape -}}
            </span>
          </a>
        {%- endif -%}
      </li>
    {%- endfor -%}
    {%- if add_journal -%}{% render 'tavia-journal-navigation', journal: navigation_journal, layout: 'desktop' %}{%- endif -%}
  </ul>
</nav>

<script src="{{ 'tavia-mega-menu.js' | asset_url }}" defer="defer"></script>
