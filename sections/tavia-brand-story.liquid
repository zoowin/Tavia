{{ 'tavia-homepage.css' | asset_url | stylesheet_tag }}

{%- style -%}
  #shopify-section-{{ section.id }} .tavia-story {
    --tavia-story-image-height: {{ section.settings.desktop_image_height }}px;
    --tavia-story-image-position: {{ section.settings.desktop_image_position }};
    --tavia-story-mobile-image-height: {{ section.settings.mobile_image_height }}px;
    --tavia-story-mobile-image-position: {{ section.settings.mobile_image_position }};
    --tavia-story-padding-top: {{ section.settings.padding_top }}px;
    --tavia-story-padding-bottom: {{ section.settings.padding_bottom }}px;
  }
{%- endstyle -%}

<section class="tavia-home-section tavia-story color-{{ section.settings.color_scheme }} gradient tavia-story--{{ section.settings.theme }}{% if section.settings.image_position == 'right' %} tavia-story--reverse{% endif %}" aria-labelledby="TaviaStoryHeading-{{ section.id }}">
  <div class="tavia-story__grid">
    <div class="tavia-story__media">
      {%- liquid
        assign desktop_image = section.settings.image
        assign mobile_image = section.settings.mobile_image
        assign fallback_image = desktop_image | default: mobile_image
        assign image_alt = desktop_image.alt | default: mobile_image.alt
      -%}
      {%- if fallback_image != blank -%}
        <picture class="tavia-story__picture">
          {%- if mobile_image != blank -%}
            <source
              media="(max-width: 749px)"
              srcset="
                {{ mobile_image | image_url: width: 375 }} 375w,
                {{ mobile_image | image_url: width: 550 }} 550w,
                {{ mobile_image | image_url: width: 750 }} 750w,
                {{ mobile_image | image_url: width: 1000 }} 1000w
              "
              sizes="100vw"
            >
          {%- endif -%}
          {{
            fallback_image
            | image_url: width: 2200
            | image_tag:
              class: 'tavia-story__image',
              widths: '600, 900, 1200, 1600, 2200',
              sizes: '(min-width: 750px) 55vw, 100vw',
              loading: 'lazy',
              alt: image_alt
          }}
        </picture>
      {%- else -%}
        {{ 'lifestyle-2' | placeholder_svg_tag: 'tavia-story__image placeholder-svg' }}
      {%- endif -%}
      {%- if section.settings.image_caption != blank -%}<p class="tavia-kicker tavia-story__caption">{{ section.settings.image_caption | escape }}</p>{%- endif -%}
    </div>

    <div class="tavia-story__content">
      {%- if section.settings.eyebrow != blank -%}<p class="tavia-kicker">{{ section.settings.eyebrow | escape }}</p>{%- endif -%}
      <h2 class="tavia-story__heading" id="TaviaStoryHeading-{{ section.id }}">{{ section.settings.heading | escape | newline_to_br }}</h2>
      {%- if section.settings.copy != blank -%}<p class="tavia-story__copy">{{ section.settings.copy | escape | newline_to_br }}</p>{%- endif -%}

      {%- if section.blocks.size > 0 -%}
        <div class="tavia-story__features">
          {%- for block in section.blocks -%}
            <div class="tavia-story__feature" {{ block.shopify_attributes }}>
              <span class="tavia-story__feature-title">{{ block.settings.title | escape }}</span>
              <span class="tavia-story__feature-text">{{ block.settings.text | escape }}</span>
            </div>
          {%- endfor -%}
        </div>
      {%- endif -%}

      {%- if section.settings.link_label != blank -%}
        <a class="tavia-underlined-link" href="{{ section.settings.link | default: routes.all_products_collection_url }}">{{ section.settings.link_label | escape }} ↗</a>
      {%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Tavia brand story",
  "tag": "section",
  "class": "tavia-homepage-section",
  "max_blocks": 5,
  "settings": [
    { "type": "select", "id": "theme", "label": "Theme", "default": "light", "options": [
      { "value": "light", "label": "Light" },
      { "value": "dark", "label": "Dark image treatment" }
    ] },
    { "type": "color_scheme", "id": "color_scheme", "label": "Color scheme", "default": "scheme-1" },
    { "type": "select", "id": "image_position", "label": "Image position", "default": "left", "options": [
      { "value": "left", "label": "Left" },
      { "value": "right", "label": "Right" }
    ] },
    { "type": "header", "content": "Images" },
    { "type": "image_picker", "id": "image", "label": "Desktop image" },
    { "type": "image_picker", "id": "mobile_image", "label": "Mobile image", "info": "Falls back to the desktop image when empty." },
    { "type": "range", "id": "desktop_image_height", "label": "Desktop image height", "min": 400, "max": 900, "step": 20, "unit": "px", "default": 640 },
    { "type": "text", "id": "desktop_image_position", "label": "Desktop image position", "default": "50% 50%", "info": "CSS object position, for example: 50% 50%." },
    { "type": "range", "id": "mobile_image_height", "label": "Mobile image height", "min": 280, "max": 760, "step": 20, "unit": "px", "default": 460 },
    { "type": "text", "id": "mobile_image_position", "label": "Mobile image position", "default": "50% 50%", "info": "CSS object position, for example: 50% 35%." },
    { "type": "text", "id": "image_caption", "label": "Image caption", "default": "Tavia / Designed for daily motion" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Why Tavia" },
    { "type": "textarea", "id": "heading", "label": "Heading", "default": "BUILT AROUND\nREAL MOVEMENT." },
    { "type": "textarea", "id": "copy", "label": "Copy", "default": "Tavia is designed for the hours between destinations—commutes, studio floors, long shifts and everything after. Lightweight, adaptable forms deliver lasting ease without unnecessary complexity." },
    { "type": "text", "id": "link_label", "label": "Link label", "default": "Discover Tavia" },
    { "type": "url", "id": "link", "label": "Link" },
    { "type": "header", "content": "Spacing" },
    { "type": "range", "id": "padding_top", "label": "Top spacing", "min": 0, "max": 160, "step": 10, "unit": "px", "default": 100 },
    { "type": "range", "id": "padding_bottom", "label": "Bottom spacing", "min": 0, "max": 160, "step": 10, "unit": "px", "default": 100 }
  ],
  "blocks": [
    {
      "type": "feature",
      "name": "Feature row",
      "settings": [
        { "type": "text", "id": "title", "label": "Title", "default": "Long-day comfort" },
        { "type": "text", "id": "text", "label": "Text", "default": "Balanced support without excess bulk" }
      ]
    }
  ],
  "presets": [{ "name": "Tavia brand story", "blocks": [{ "type": "feature" }, { "type": "feature" }, { "type": "feature" }] }]
}
{% endschema %}
