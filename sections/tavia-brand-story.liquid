{{ 'tavia-homepage.css' | asset_url | stylesheet_tag }}

{%- style -%}
  #shopify-section-{{ section.id }} .tavia-story {
    --tavia-story-background: {{ section.settings.background }};
    --tavia-story-color: {{ section.settings.text_color }};
  }
{%- endstyle -%}

<section class="tavia-home-section tavia-story tavia-story--{{ section.settings.theme }}{% if section.settings.image_position == 'right' %} tavia-story--reverse{% endif %}" aria-labelledby="TaviaStoryHeading-{{ section.id }}">
  <div class="tavia-story__grid">
    <div class="tavia-story__media">
      {%- if section.settings.image != blank -%}
        {{
          section.settings.image
          | image_url: width: 2200
          | image_tag:
            class: 'tavia-story__image',
            widths: '600, 900, 1200, 1600, 2200',
            sizes: '(min-width: 750px) 55vw, 100vw',
            loading: 'lazy',
            alt: section.settings.image.alt
        }}
      {%- else -%}
        {{ 'lifestyle-2' | placeholder_svg_tag: 'tavia-story__image placeholder-svg' }}
      {%- endif -%}
      {%- if section.settings.image_caption != blank -%}<p class="tavia-kicker tavia-story__caption">{{ section.settings.image_caption | escape }}</p>{%- endif -%}
    </div>

    <div class="tavia-story__content">
      {%- if section.settings.eyebrow != blank -%}<p class="tavia-kicker">{{ section.settings.eyebrow | escape }}</p>{%- endif -%}
      <h2 class="tavia-story__heading" id="TaviaStoryHeading-{{ section.id }}">{{ section.settings.heading | escape | newline_to_br }}</h2>
      {%- if section.settings.copy != blank -%}<p class="tavia-story__copy">{{ section.settings.copy | escape | newline_to_br }}</p>{%- endif -%}

      {%- if section.blocks.size > 0 -%}
        <div class="tavia-story__features">
          {%- for block in section.blocks -%}
            <div class="tavia-story__feature" {{ block.shopify_attributes }}>
              <span class="tavia-story__feature-title">{{ block.settings.title | escape }}</span>
              <span class="tavia-story__feature-text">{{ block.settings.text | escape }}</span>
            </div>
          {%- endfor -%}
        </div>
      {%- endif -%}

      {%- if section.settings.link_label != blank -%}
        <a class="tavia-underlined-link" href="{{ section.settings.link | default: routes.all_products_collection_url }}">{{ section.settings.link_label | escape }} ↗</a>
      {%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Tavia brand story",
  "tag": "section",
  "class": "tavia-homepage-section",
  "max_blocks": 5,
  "settings": [
    { "type": "select", "id": "theme", "label": "Theme", "default": "light", "options": [
      { "value": "light", "label": "Light" },
      { "value": "dark", "label": "Dark image treatment" }
    ] },
    { "type": "color", "id": "background", "label": "Background", "default": "#ffffff" },
    { "type": "color", "id": "text_color", "label": "Text color", "default": "#111111" },
    { "type": "select", "id": "image_position", "label": "Image position", "default": "left", "options": [
      { "value": "left", "label": "Left" },
      { "value": "right", "label": "Right" }
    ] },
    { "type": "image_picker", "id": "image", "label": "Image" },
    { "type": "text", "id": "image_caption", "label": "Image caption", "default": "Lifestyle film / Full shift / City" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow" },
    { "type": "textarea", "id": "heading", "label": "Heading", "default": "MADE TO STAY\nIN MOTION." },
    { "type": "textarea", "id": "copy", "label": "Copy", "default": "For commutes, studio floors, long shifts and the hours in between. The structure is designed to move with you." },
    { "type": "text", "id": "link_label", "label": "Link label", "default": "See how it feels" },
    { "type": "url", "id": "link", "label": "Link" }
  ],
  "blocks": [
    {
      "type": "feature",
      "name": "Feature row",
      "settings": [
        { "type": "text", "id": "title", "label": "Title", "default": "Light on foot" },
        { "type": "text", "id": "text", "label": "Text", "default": "Less visual and physical weight" }
      ]
    }
  ],
  "presets": [{ "name": "Tavia brand story", "blocks": [{ "type": "feature" }, { "type": "feature" }, { "type": "feature" }] }]
}
{% endschema %}
