{{ 'tavia-collection.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign active_profile = nil
  for block in section.blocks
    if block.settings.collection.handle == collection.handle and block.settings.collection != blank
      assign active_profile = block
      break
    endif
  endfor
  assign profile = active_profile.settings
  assign hero_image = profile.image | default: collection.image
  assign mobile_image = profile.mobile_image
  assign hero_alt = hero_image.alt | default: collection.title
  assign desktop_position = hero_image.presentation.focal_point | default: 'center center'
  assign mobile_position = mobile_image.presentation.focal_point | default: desktop_position
  assign hero_loading = 'eager'
  assign hero_priority = 'high'
  if section.index > 2
    assign hero_loading = 'lazy'
    assign hero_priority = 'auto'
  endif
  assign has_benefits = false
  if profile.benefit_1_title != blank or profile.benefit_2_title != blank or profile.benefit_3_title != blank
    assign has_benefits = true
  endif
-%}

<div
  class="tavia-collection-intro{% if hero_image == blank %} tavia-collection-intro--text-only{% endif %}{% if profile.heading == blank %} tavia-collection-intro--no-theme{% endif %}"
  style="--tavia-collection-desktop-position: {{ desktop_position }}; --tavia-collection-mobile-position: {{ mobile_position }};"
  {% if active_profile != blank %}{{ active_profile.shopify_attributes }}{% endif %}
>
  <header class="tavia-collection-hero" aria-labelledby="TaviaCollectionTitle-{{ section.id }}">
    <div class="tavia-collection-hero__content">
      <h1 class="tavia-collection-hero__heading" id="TaviaCollectionTitle-{{ section.id }}">
        <span class="tavia-collection-hero__name">{{ collection.title | escape }}</span>
        {%- if profile.heading != blank -%}
          <span class="tavia-collection-hero__theme">{{ profile.heading | escape }}</span>
        {%- endif -%}
      </h1>
      {%- if profile.intro != blank -%}
        <p class="tavia-collection-hero__intro">{{ profile.intro | escape }}</p>
      {%- endif -%}
    </div>
    {%- if hero_image != blank -%}
      <picture class="tavia-collection-hero__media">
        {%- if mobile_image != blank -%}
          <source
            media="(max-width: 749px)"
            srcset="{{ mobile_image | image_url: width: 375 }} 375w, {{ mobile_image | image_url: width: 550 }} 550w, {{ mobile_image | image_url: width: 750 }} 750w, {{ mobile_image | image_url: width: 900 }} 900w"
            sizes="100vw"
            width="{{ mobile_image.width }}"
            height="{{ mobile_image.height }}"
          >
        {%- endif -%}
        {{
          hero_image
          | image_url: width: 2000
          | image_tag:
            class: 'tavia-collection-hero__image',
            widths: '550, 750, 1000, 1200, 1600, 2000',
            sizes: '(min-width: 1600px) 960px, (min-width: 750px) 60vw, 100vw',
            loading: hero_loading,
            fetchpriority: hero_priority,
            alt: hero_alt
        }}
      </picture>
    {%- endif -%}
  </header>

  {%- if has_benefits -%}
    <ul class="tavia-collection-benefits" role="list">
      {%- for index in (1..3) -%}
        {%- liquid
          assign title_key = 'benefit_' | append: index | append: '_title'
          assign text_key = 'benefit_' | append: index | append: '_text'
          assign benefit_title = profile[title_key]
          assign benefit_text = profile[text_key]
        -%}
        {%- if benefit_title != blank -%}
          <li class="tavia-collection-benefit">
            <span class="tavia-collection-benefit__index" aria-hidden="true">0{{ index }}</span>
            <div>
              <h2 class="tavia-collection-benefit__title">{{ benefit_title | escape }}</h2>
              {%- if benefit_text != blank -%}
                <p class="tavia-collection-benefit__text">{{ benefit_text | escape }}</p>
              {%- endif -%}
            </div>
          </li>
        {%- endif -%}
      {%- endfor -%}
    </ul>
  {%- endif -%}
</div>

{% schema %}
{
  "name": "Tavia collection intro",
  "class": "tavia-collection-intro-section",
  "enabled_on": { "templates": ["collection"] },
  "max_blocks": 12,
  "settings": [
    { "type": "paragraph", "content": "One profile per collection. The matching profile supplies its banner and up to three highlights. Other collections use their own title and image." }
  ],
  "blocks": [
    {
      "type": "profile",
      "name": "Collection profile",
      "settings": [
        { "type": "collection", "id": "collection", "label": "Collection" },
        { "type": "text", "id": "heading", "label": "Theme heading" },
        { "type": "textarea", "id": "intro", "label": "Short introduction" },
        { "type": "image_picker", "id": "image", "label": "Desktop banner", "info": "Uses the collection image when empty. Recommended: 1600 × 1200 px." },
        { "type": "image_picker", "id": "mobile_image", "label": "Mobile banner", "info": "Optional portrait image. Recommended: 900 × 1200 px." },
        { "type": "header", "content": "Highlight 1" },
        { "type": "text", "id": "benefit_1_title", "label": "Heading" },
        { "type": "textarea", "id": "benefit_1_text", "label": "Description" },
        { "type": "header", "content": "Highlight 2" },
        { "type": "text", "id": "benefit_2_title", "label": "Heading" },
        { "type": "textarea", "id": "benefit_2_text", "label": "Description" },
        { "type": "header", "content": "Highlight 3" },
        { "type": "text", "id": "benefit_3_title", "label": "Heading" },
        { "type": "textarea", "id": "benefit_3_text", "label": "Description" }
      ]
    }
  ],
  "presets": [{ "name": "Tavia collection intro" }]
}
{% endschema %}
