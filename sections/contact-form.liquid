{{ 'section-contact-form.css' | asset_url | stylesheet_tag }}

{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
{%- endstyle -%}

<div class="color-{{ section.settings.color_scheme }} gradient">
  <div class="contact contact--refined page-width page-width--narrow section-{{ section.id }}-padding">
    {%- if section.settings.heading != blank -%}
      <h2 class="title title-wrapper--no-top-margin inline-richtext {{ section.settings.heading_size }}{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}">
        {{ section.settings.heading }}
      </h2>
    {%- else -%}
      <h2 class="visually-hidden">{{ 'templates.contact.form.title' | t }}</h2>
    {%- endif -%}
    {%- if section.settings.support_email != blank -%}
      <p class="contact__email">
        <a href="mailto:{{ section.settings.support_email | strip | escape }}">{{ section.settings.support_email | escape }}</a>
      </p>
    {%- endif -%}
    {%- liquid
      assign contact_form_class = 'isolate'
      if settings.animations_reveal_on_scroll
        assign contact_form_class = 'isolate scroll-trigger animate--slide-in'
      endif
    -%}
    {%- form 'contact', id: 'ContactForm', class: contact_form_class -%}
      {%- if form.posted_successfully? -%}
        <h2 class="form-status form-status-list form__message" tabindex="-1" autofocus>
          {{- 'icon-success.svg' | inline_asset_content -}}
          {{ 'templates.contact.form.post_success' | t }}
        </h2>
      {%- elsif form.errors -%}
        <div class="form__message">
          <h2 class="form-status caption-large text-body" role="alert" tabindex="-1" autofocus>
            {{- 'icon-error.svg' | inline_asset_content -}}
            {{ 'templates.contact.form.error_heading' | t }}
          </h2>
        </div>
        <ul class="form-status-list caption-large" role="list">
          <li>
            <a href="#ContactForm-email" class="link">
              {{ form.errors.translated_fields.email | capitalize }}
              {{ form.errors.messages.email }}
            </a>
          </li>
        </ul>
      {%- endif -%}
      <div class="contact__fields">
        <div class="field">
          <input
            class="field__input"
            autocomplete="name"
            type="text"
            id="ContactForm-name"
            name="contact[{{ 'templates.contact.form.name' | t }}]"
            value="{% if form.name %}{{ form.name }}{% elsif customer %}{{ customer.name }}{% endif %}"
          >
          <label class="field__label" for="ContactForm-name">{{ 'templates.contact.form.name' | t }}</label>
        </div>
        <div class="field field--with-error">
          <input
            autocomplete="email"
            type="email"
            id="ContactForm-email"
            class="field__input"
            name="contact[email]"
            spellcheck="false"
            autocapitalize="off"
            value="{% if form.email %}{{ form.email }}{% elsif customer %}{{ customer.email }}{% endif %}"
            aria-required="true"
            {% if form.errors contains 'email' %}
              aria-invalid="true"
              aria-describedby="ContactForm-email-error"
            {% endif %}
            required
          >
          <label class="field__label" for="ContactForm-email">
            {{- 'templates.contact.form.email' | t }}
            <span aria-hidden="true">*</span></label
          >
          {%- if form.errors contains 'email' -%}
            <small class="contact__field-error" id="ContactForm-email-error">
              <span class="visually-hidden">{{ 'accessibility.error' | t }}</span>
              <span class="form__message">
                <span class="svg-wrapper">
                  {{- 'icon-error.svg' | inline_asset_content -}}
                </span>
                {{- form.errors.translated_fields.email | capitalize }}
                {{ form.errors.messages.email -}}
              </span>
            </small>
          {%- endif -%}
        </div>
      </div>
      <div class="contact__phone-row">
        <div class="field contact__dial-code">
          <label class="field__label" for="ContactForm-dial-code-{{ section.id }}">{{ 'localization.country_label' | t }}</label>
          <div class="select">
            <select class="select__select" id="ContactForm-dial-code-{{ section.id }}" name="contact[Country calling code]" autocomplete="tel-country-code">
              <option value="">+…</option>
              {%- assign dial_codes = '1:US/CA,44:GB,61:AU,64:NZ,33:FR,49:DE,39:IT,34:ES,31:NL,32:BE,41:CH,43:AT,353:IE,351:PT,45:DK,46:SE,47:NO,358:FI,48:PL,420:CZ,30:GR,36:HU,40:RO,90:TR,380:UA,7:RU/KZ,86:CN,852:HK,853:MO,886:TW,81:JP,82:KR,65:SG,60:MY,66:TH,84:VN,62:ID,63:PH,91:IN,92:PK,880:BD,971:AE,966:SA,972:IL,27:ZA,234:NG,20:EG,52:MX,55:BR,54:AR' | split: ',' -%}
              {%- for entry in dial_codes -%}
                {%- assign dial_parts = entry | split: ':' -%}
                {%- assign dial_value = '+' | append: dial_parts.first -%}
                <option value="{{ dial_value }}"{% if form['Country calling code'] == dial_value %} selected{% elsif form['Country calling code'] == blank and forloop.first %} selected{% endif %}>{{ dial_value }} {{ dial_parts.last }}</option>
              {%- endfor -%}
            </select>
            <span class="svg-wrapper">{{ 'icon-caret.svg' | inline_asset_content }}</span>
          </div>
        </div>
        <div class="field contact__phone-number">
        <input
          type="tel"
          id="ContactForm-phone"
          class="field__input"
          autocomplete="tel"
          name="contact[phone]"
          value="{% if form.phone %}{{ form.phone | escape }}{% elsif customer %}{{ customer.phone | escape }}{% endif %}"
        >
        <label class="field__label" for="ContactForm-phone">{{ 'templates.contact.form.phone' | t }}</label>
        </div>
      </div>
      <div class="field">
        <textarea
          rows="10"
          id="ContactForm-body"
          class="text-area field__input"
          name="contact[{{ 'templates.contact.form.comment' | t }}]"
        >
          {{- form.body -}}
        </textarea>
        <label class="form__label field__label" for="ContactForm-body">
          {{- 'templates.contact.form.comment' | t -}}
        </label>
      </div>
      <div class="contact__button">
        <button type="submit" class="button">
          {{ 'templates.contact.form.send' | t }}
        </button>
      </div>
    {%- endform -%}
  </div>
</div>

{% javascript %}
  document.addEventListener('formdata', (event) => {
    const code = event.target.querySelector('.contact__dial-code select');
    const phone = event.target.querySelector('.contact__phone-number input');
    if (!code || !phone) return;
    const number = phone.value.trim();
    if (!number || /^(\+|00)/.test(number)) {
      event.formData.delete(code.name);
      event.formData.set(phone.name, number);
      return;
    }
    event.formData.set(phone.name, [code.value, number].filter(Boolean).join(' '));
  }, true);
{% endjavascript %}

{% stylesheet %}
  .contact--refined .title { margin-bottom: 1.2rem; }
  .contact--refined form { margin-top: 3.2rem; }
  .contact--refined .contact__email { margin: 0; font-size: 1.6rem; line-height: 1.5; }
  .contact__email a { color: inherit; text-underline-offset: 0.4rem; text-decoration-thickness: 1px; }
  .contact--refined .field {
    display: flex;
    flex-direction: column;
    align-items: stretch;
    gap: 0.8rem;
    margin-bottom: 2.4rem;
  }
  .contact--refined .field::before,
  .contact--refined .field::after,
  .contact--refined .select::before,
  .contact--refined .select::after { display: none; }
  .contact--refined .field .field__label {
    position: static;
    order: -1;
    transform: none;
    margin: 0;
    font-size: 1.3rem;
    font-weight: 500;
    line-height: 1.5;
    letter-spacing: 0;
    color: rgba(var(--color-foreground), 0.75);
    pointer-events: auto;
  }
  .contact--refined .field .field__input,
  .contact--refined .field .select__select {
    box-sizing: border-box;
    width: 100%;
    min-height: 5rem;
    height: 5rem;
    margin: 0;
    padding: 1.2rem 1.4rem;
    border: 1px solid rgba(var(--color-foreground), 0.3);
    border-radius: 0;
    box-shadow: none;
    background: rgb(var(--color-background));
    color: rgb(var(--color-foreground));
    font-family: var(--font-body-family);
    font-size: 1.6rem;
    line-height: 1.4;
    letter-spacing: 0;
    transition: border-color 160ms ease;
  }
  .contact--refined .field .text-area { height: 16rem; min-height: 12rem; resize: vertical; }
  .contact--refined .field__input:hover,
  .contact--refined .select__select:hover { border-color: rgba(var(--color-foreground), 0.65); }
  .contact--refined .field .field__input:focus,
  .contact--refined .field .select__select:focus {
    border-color: rgb(var(--color-foreground));
    outline: 2px solid rgba(var(--color-foreground), 0.5);
    outline-offset: 2px;
    box-shadow: none;
  }
  .contact--refined .contact__button { margin-top: 0.8rem; }
  .contact--refined .contact__button .button { min-height: 4.8rem; min-width: 14rem; }
  .contact__phone-row {
    display: grid;
    grid-template-columns: 14rem minmax(0, 1fr);
    gap: 1rem;
  }
  .contact__phone-row .field { min-width: 0; }
  .contact__dial-code .select { width: 100%; position: relative; }
  .contact--refined .contact__dial-code .select__select { padding-right: 3.6rem; }
  .contact--refined .contact__dial-code .select > .svg-wrapper {
    position: absolute;
    inset: 50% 1.4rem auto auto;
    width: 1rem;
    height: 0.6rem;
    transform: translateY(-50%);
    pointer-events: none;
  }
  .contact--refined .contact__dial-code .svg-wrapper .icon-caret { position: static; width: 100%; height: 100%; }
  .contact__dial-code .select__select {
    min-height: 4.5rem;
    height: 100%;
    padding: 0 2.8rem 0 1.2rem;
    font-size: 1.6rem;
    letter-spacing: 0;
  }
  @media (max-width: 749px) {
    .contact__phone-row { grid-template-columns: 13rem minmax(0, 1fr); gap: 0.8rem; }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:sections.contact-form.name",
  "tag": "section",
  "class": "section",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "text",
      "id": "support_email",
      "label": "Support email",
      "default": "support@tavialab.com"
    },
    {
      "type": "inline_richtext",
      "id": "heading",
      "default": "t:sections.contact-form.settings.title.default",
      "label": "t:sections.contact-form.settings.title.label"
    },
    {
      "type": "select",
      "id": "heading_size",
      "options": [
        {
          "value": "h2",
          "label": "t:sections.all.heading_size.options__1.label"
        },
        {
          "value": "h1",
          "label": "t:sections.all.heading_size.options__2.label"
        },
        {
          "value": "h0",
          "label": "t:sections.all.heading_size.options__3.label"
        },
        {
          "value": "hxl",
          "label": "t:sections.all.heading_size.options__4.label"
        },
        {
          "value": "hxxl",
          "label": "t:sections.all.heading_size.options__5.label"
        }
      ],
      "default": "h1",
      "label": "t:sections.all.heading_size.label"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:sections.all.colors.label",
      "default": "scheme-1"
    },
    {
      "type": "header",
      "content": "t:sections.all.padding.section_padding_heading"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_top",
      "default": 36
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_bottom",
      "default": 36
    }
  ],
  "presets": [
    {
      "name": "t:sections.contact-form.presets.name"
    }
  ]
}
{% endschema %}
