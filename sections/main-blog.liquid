{{ 'tavia-journal.css' | asset_url | stylesheet_tag }}
{%- style -%}
  #Journal-{{ section.id }} { padding-bottom: {{ section.settings.padding_bottom }}px; }
  #Journal-{{ section.id }} .tavia-journal__intro { padding-top: {{ section.settings.padding_top }}px; }
{%- endstyle -%}
<div id="Journal-{{ section.id }}" class="tavia-journal page-width">
  <header class="tavia-journal__intro">
    {%- if section.settings.eyebrow != blank -%}<p class="tavia-journal__eyebrow">{{ section.settings.eyebrow | escape }}</p>{%- endif -%}
    <h1 class="tavia-journal__title">{{ section.settings.heading | default: blog.title | escape }}</h1>
    {%- if section.settings.introduction != blank -%}<div class="tavia-journal__description">{{ section.settings.introduction }}</div>{%- endif -%}
  </header>
  {%- paginate blog.articles by 6 -%}
    {%- if blog.articles_count > 0 -%}
      <div class="tavia-journal__grid">
        {%- for entry in blog.articles -%}
          {%- assign eager_image = false -%}
          {%- if forloop.first -%}{%- assign eager_image = true -%}{%- endif -%}
          {%- render 'tavia-journal-card', entry: entry, show_image: section.settings.show_image, show_date: section.settings.show_date, show_author: section.settings.show_author, link_label: section.settings.read_label, eager_image: eager_image -%}
        {%- endfor -%}
      </div>
    {%- else -%}
      <p class="tavia-journal__empty">{{ section.settings.empty_message | escape }}</p>
    {%- endif -%}
    {%- if paginate.pages > 1 -%}{%- render 'pagination', paginate: paginate -%}{%- endif -%}
  {%- endpaginate -%}
</div>

{% schema %}
{
  "name": "t:sections.main-blog.name",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "TAVIA LAB / JOURNAL"
    },
    {
      "type": "richtext",
      "id": "introduction",
      "label": "Introduction",
      "default": "<p>Product guides, visible structures and new ways to approach everyday objects.</p>"
    },
    {
      "type": "text",
      "id": "read_label",
      "label": "Article link label",
      "default": "Read article"
    },
    {
      "type": "text",
      "id": "empty_message",
      "label": "Empty blog message",
      "default": "New product guides and stories are on the way."
    },
    {
      "type": "checkbox",
      "id": "show_image",
      "default": true,
      "label": "t:sections.main-blog.settings.show_image.label"
    },
    {
      "type": "checkbox",
      "id": "show_date",
      "default": true,
      "label": "t:sections.main-blog.settings.show_date.label"
    },
    {
      "type": "checkbox",
      "id": "show_author",
      "default": false,
      "label": "t:sections.main-blog.settings.show_author.label"
    },
    {
      "type": "header",
      "content": "t:sections.all.padding.section_padding_heading"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_top",
      "default": 36
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_bottom",
      "default": 36
    }
  ]
}
{% endschema %}
