{{ 'tavia-homepage.css' | asset_url | stylesheet_tag }}

{%- style -%}
  #shopify-section-{{ section.id }} .tavia-hero {
    --tavia-hero-color: {{ section.settings.text_color }};
    --tavia-hero-height: {{ section.settings.desktop_height }}px;
    --tavia-hero-mobile-height: {{ section.settings.mobile_height }}px;
    --tavia-hero-overlay: {{ section.settings.overlay_opacity | divided_by: 100.0 }};
    --tavia-hero-position: {{ section.settings.desktop_position }};
    --tavia-hero-mobile-position: {{ section.settings.mobile_position }};
  }
{%- endstyle -%}

<section class="tavia-home-section tavia-hero" aria-labelledby="TaviaHeroHeading-{{ section.id }}">
  <div class="tavia-hero__media">
    {%- if section.settings.image != blank -%}
      {{
        section.settings.image
        | image_url: width: 3000
        | image_tag:
          class: 'tavia-hero__image',
          widths: '750, 1100, 1500, 2000, 2500, 3000',
          sizes: '100vw',
          loading: 'eager',
          fetchpriority: 'high',
          alt: section.settings.image.alt
      }}
    {%- else -%}
      {{ 'lifestyle-1' | placeholder_svg_tag: 'tavia-hero__image placeholder-svg' }}
    {%- endif -%}
  </div>

  <nav class="tavia-hero__nav" aria-label="Primary">
    <a class="tavia-hero__menu" href="{{ section.settings.menu_link | default: routes.all_products_collection_url }}">
      <span class="tavia-hero__menu-label">{{ section.settings.menu_label | escape }}</span>
      <span class="tavia-hero__menu-icon" aria-hidden="true"><span></span><span></span><span></span></span>
    </a>
    <a class="tavia-hero__wordmark" href="{{ routes.root_url }}">{{ section.settings.wordmark | escape }}</a>
    <div class="tavia-hero__utilities">
      <a class="tavia-hero__utility tavia-hero__utility--account" href="{{ routes.account_url }}">{{ section.settings.account_label | escape }}</a>
      <a class="tavia-hero__utility" href="{{ routes.cart_url }}">{{ section.settings.cart_label | escape }} ({{ cart.item_count }})</a>
    </div>
  </nav>

  <div class="tavia-hero__content">
    {%- if section.settings.eyebrow != blank -%}<p class="tavia-kicker tavia-hero__eyebrow">{{ section.settings.eyebrow | escape }}</p>{%- endif -%}
    <h1 class="tavia-hero__heading" id="TaviaHeroHeading-{{ section.id }}">{{ section.settings.heading | escape }}</h1>
    {%- if section.settings.copy != blank -%}<p class="tavia-hero__copy">{{ section.settings.copy | escape }}</p>{%- endif -%}
    {%- if section.settings.button_label != blank -%}
      <a class="tavia-hero__button" href="{{ section.settings.button_link | default: routes.all_products_collection_url }}">{{ section.settings.button_label | escape }}</a>
    {%- endif -%}
  </div>

  <div class="tavia-hero__bottom">
    <p class="tavia-kicker">{{ section.settings.bottom_left | escape }}</p>
    <p class="tavia-kicker">{{ section.settings.bottom_right | escape }}</p>
  </div>
</section>

{%- if section.blocks.size > 0 -%}
  <div class="tavia-home-section tavia-marquee" aria-label="Product benefits">
    <div class="tavia-marquee__track">
      {%- for iteration in (1..2) -%}
        {%- for block in section.blocks -%}
          <span class="tavia-marquee__item" {% if iteration == 1 %}{{ block.shopify_attributes }}{% else %}aria-hidden="true"{% endif %}>{{ block.settings.text | escape }}</span>
        {%- endfor -%}
      {%- endfor -%}
    </div>
  </div>
{%- endif -%}

{% schema %}
{
  "name": "Tavia hero",
  "tag": "section",
  "class": "tavia-homepage-section",
  "max_blocks": 8,
  "settings": [
    { "type": "image_picker", "id": "image", "label": "Hero image" },
    { "type": "text", "id": "wordmark", "label": "Wordmark", "default": "TAVIA" },
    { "type": "text", "id": "menu_label", "label": "Menu label", "default": "Menu" },
    { "type": "url", "id": "menu_link", "label": "Menu link" },
    { "type": "text", "id": "account_label", "label": "Account label", "default": "Account" },
    { "type": "text", "id": "cart_label", "label": "Cart label", "default": "Bag" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Video / City shift / Product in motion" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "BUILT FOR LONG DAYS." },
    { "type": "textarea", "id": "copy", "label": "Copy", "default": "A one-piece shoe designed for people who stay in motion." },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "Discover the 01" },
    { "type": "url", "id": "button_link", "label": "Button link" },
    { "type": "text", "id": "bottom_left", "label": "Bottom left label", "default": "Drop 01 / First production" },
    { "type": "text", "id": "bottom_right", "label": "Bottom right label", "default": "Designed for daily motion" },
    { "type": "color", "id": "text_color", "label": "Text color", "default": "#ffffff" },
    { "type": "range", "id": "overlay_opacity", "min": 0, "max": 60, "step": 5, "unit": "%", "label": "Image overlay", "default": 15 },
    { "type": "range", "id": "desktop_height", "min": 600, "max": 1100, "step": 20, "unit": "px", "label": "Desktop height", "default": 900 },
    { "type": "range", "id": "mobile_height", "min": 520, "max": 900, "step": 20, "unit": "px", "label": "Mobile height", "default": 720 },
    { "type": "text", "id": "desktop_position", "label": "Desktop image position", "default": "50% 50%", "info": "Use CSS object-position, for example 50% 60%." },
    { "type": "text", "id": "mobile_position", "label": "Mobile image position", "default": "50% 50%" }
  ],
  "blocks": [
    {
      "type": "benefit",
      "name": "Benefit",
      "settings": [{ "type": "text", "id": "text", "label": "Text", "default": "One-piece construction" }]
    }
  ],
  "presets": [{ "name": "Tavia hero", "blocks": [{ "type": "benefit" }, { "type": "benefit" }, { "type": "benefit" }] }]
}
{% endschema %}
