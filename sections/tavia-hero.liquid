{{ 'tavia-homepage.css' | asset_url | stylesheet_tag }}

{%- style -%}
  #shopify-section-{{ section.id }} .tavia-hero {
    --tavia-hero-color: {{ section.settings.text_color }};
    --tavia-hero-height: {{ section.settings.desktop_height }}px;
    --tavia-hero-mobile-height: {{ section.settings.mobile_height }}px;
    --tavia-hero-heading-size: {{ section.settings.heading_size_desktop }}px;
    --tavia-hero-heading-size-mobile: {{ section.settings.heading_size_mobile }}px;
    --tavia-hero-heading-width: {{ section.settings.heading_width_desktop }}px;
    --tavia-hero-mobile-content-offset: {{ section.settings.mobile_content_offset }}px;
    --tavia-hero-overlay: {{ section.settings.overlay_opacity | divided_by: 100.0 }};
    --tavia-hero-position: {{ section.settings.desktop_position }};
    --tavia-hero-mobile-position: {{ section.settings.mobile_position }};
  }
{%- endstyle -%}

<section
  class="tavia-home-section tavia-hero tavia-hero--desktop-{{ section.settings.content_alignment_desktop }} tavia-hero--mobile-{{ section.settings.content_alignment_mobile }}"
  aria-labelledby="TaviaHeroHeading-{{ section.id }}"
>
  <div class="tavia-hero__media">
    {%- liquid
      assign desktop_image = section.settings.image
      assign mobile_image = section.settings.mobile_image
      assign fallback_image = desktop_image | default: mobile_image
      assign image_alt = desktop_image.alt | default: mobile_image.alt
    -%}
    {%- if fallback_image != blank -%}
      <picture class="tavia-hero__picture">
        {%- if mobile_image != blank -%}
          <source
            media="(max-width: 749px)"
            srcset="
              {{ mobile_image | image_url: width: 375 }} 375w,
              {{ mobile_image | image_url: width: 550 }} 550w,
              {{ mobile_image | image_url: width: 750 }} 750w,
              {{ mobile_image | image_url: width: 1000 }} 1000w,
              {{ mobile_image | image_url: width: 1200 }} 1200w
            "
            sizes="100vw"
          >
        {%- endif -%}
        {{
          fallback_image
          | image_url: width: 3000
          | image_tag:
            class: 'tavia-hero__image',
            widths: '750, 1100, 1500, 2000, 2500, 3000',
            sizes: '100vw',
            loading: 'eager',
            fetchpriority: 'high',
            alt: image_alt
        }}
      </picture>
    {%- else -%}
      {{ 'lifestyle-1' | placeholder_svg_tag: 'tavia-hero__image placeholder-svg' }}
    {%- endif -%}
  </div>

  <div class="tavia-hero__content">
    {%- if section.settings.eyebrow != blank -%}<p class="tavia-kicker tavia-hero__eyebrow">{{ section.settings.eyebrow | escape }}</p>{%- endif -%}
    <h1 class="tavia-hero__heading" id="TaviaHeroHeading-{{ section.id }}">{{ section.settings.heading | escape | newline_to_br }}</h1>
    {%- if section.settings.copy != blank -%}<p class="tavia-hero__copy">{{ section.settings.copy | escape }}</p>{%- endif -%}
    {%- if section.settings.button_label != blank -%}
      <a class="tavia-hero__button" href="{{ section.settings.button_link | default: routes.all_products_collection_url }}">{{ section.settings.button_label | escape }}</a>
    {%- endif -%}
  </div>

  <div class="tavia-hero__bottom">
    <p class="tavia-kicker">{{ section.settings.bottom_left | escape }}</p>
    <p class="tavia-kicker">{{ section.settings.bottom_right | escape }}</p>
  </div>
</section>

{% schema %}
{
  "name": "Tavia hero",
  "tag": "section",
  "class": "tavia-homepage-section",
  "settings": [
    { "type": "image_picker", "id": "image", "label": "Desktop image" },
    { "type": "image_picker", "id": "mobile_image", "label": "Mobile image", "info": "Falls back to the desktop image when empty." },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Video / City shift / Product in motion" },
    { "type": "textarea", "id": "heading", "label": "Heading", "info": "Add line breaks to control the title composition.", "default": "BUILT FOR LONG DAYS." },
    { "type": "select", "id": "content_alignment_desktop", "label": "Content alignment — desktop", "default": "center", "options": [
      { "value": "left", "label": "Left" },
      { "value": "center", "label": "Center" }
    ] },
    { "type": "select", "id": "content_alignment_mobile", "label": "Content alignment — mobile", "default": "center", "options": [
      { "value": "left", "label": "Left" },
      { "value": "center", "label": "Center" }
    ] },
    { "type": "range", "id": "heading_width_desktop", "min": 420, "max": 1000, "step": 20, "unit": "px", "label": "Heading width — left layout", "default": 760 },
    { "type": "range", "id": "heading_size_desktop", "min": 36, "max": 120, "step": 2, "unit": "px", "label": "Heading size — desktop", "default": 88 },
    { "type": "range", "id": "heading_size_mobile", "min": 32, "max": 72, "step": 2, "unit": "px", "label": "Heading size — mobile", "default": 58 },
    { "type": "range", "id": "mobile_content_offset", "min": -160, "max": 160, "step": 10, "unit": "px", "label": "Mobile content vertical offset", "info": "Negative values move the title, copy and button upward.", "default": 0 },
    { "type": "textarea", "id": "copy", "label": "Copy", "default": "A one-piece shoe designed for people who stay in motion." },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "Discover the 01" },
    { "type": "url", "id": "button_link", "label": "Button link" },
    { "type": "text", "id": "bottom_left", "label": "Bottom left label", "default": "Drop 01 / First production" },
    { "type": "text", "id": "bottom_right", "label": "Bottom right label", "default": "Designed for daily motion" },
    { "type": "color", "id": "text_color", "label": "Text color", "default": "#ffffff" },
    { "type": "range", "id": "overlay_opacity", "min": 0, "max": 60, "step": 5, "unit": "%", "label": "Image overlay", "default": 15 },
    { "type": "range", "id": "desktop_height", "min": 600, "max": 1100, "step": 20, "unit": "px", "label": "Desktop height", "default": 900 },
    { "type": "range", "id": "mobile_height", "min": 520, "max": 900, "step": 20, "unit": "px", "label": "Mobile height", "default": 720 },
    { "type": "text", "id": "desktop_position", "label": "Desktop image position", "default": "50% 50%", "info": "Use CSS object-position, for example 50% 60%." },
    { "type": "text", "id": "mobile_position", "label": "Mobile image position", "default": "50% 50%" }
  ],
  "presets": [{ "name": "Tavia hero" }]
}
{% endschema %}
