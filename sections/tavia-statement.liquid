{{ 'tavia-homepage.css' | asset_url | stylesheet_tag }}

{%- style -%}
  #shopify-section-{{ section.id }} .tavia-statement {
    --tavia-statement-background: {{ section.settings.background_color }};
    --tavia-statement-label-color: {{ section.settings.label_color }};
    --tavia-statement-heading-color: {{ section.settings.heading_color }};
    --tavia-statement-copy-color: {{ section.settings.copy_color }};
    --tavia-statement-link-color: {{ section.settings.link_color }};
    --tavia-statement-overlay-color: {{ section.settings.overlay_color }};
    --tavia-statement-overlay-opacity: {{ section.settings.overlay_opacity | divided_by: 100.0 }};
    --tavia-statement-height: {{ section.settings.desktop_height }}px;
    --tavia-statement-mobile-height: {{ section.settings.mobile_height }}px;
    --tavia-statement-image-position: {{ section.settings.desktop_image_position }};
    --tavia-statement-mobile-image-position: {{ section.settings.mobile_image_position }};
    --tavia-statement-heading-width: {{ section.settings.heading_width_desktop }}px;
    --tavia-statement-mobile-heading-width: {{ section.settings.heading_width_mobile }}px;
  }
{%- endstyle -%}

<section class="tavia-home-section tavia-statement" aria-labelledby="TaviaStatementHeading-{{ section.id }}">
  {%- liquid
    assign desktop_image = section.settings.desktop_image
    assign mobile_image = section.settings.mobile_image
    assign fallback_image = desktop_image | default: mobile_image
  -%}

  {%- if fallback_image != blank -%}
    <div class="tavia-statement__media" aria-hidden="true">
      <picture class="tavia-statement__picture">
        {%- if mobile_image != blank -%}
          <source
            media="(max-width: 749px)"
            srcset="
              {{ mobile_image | image_url: width: 375 }} 375w,
              {{ mobile_image | image_url: width: 550 }} 550w,
              {{ mobile_image | image_url: width: 750 }} 750w,
              {{ mobile_image | image_url: width: 1000 }} 1000w
            "
            sizes="100vw"
          >
        {%- endif -%}
        {{
          fallback_image
          | image_url: width: 2400
          | image_tag:
            class: 'tavia-statement__image',
            widths: '750, 1100, 1600, 2000, 2400',
            sizes: '100vw',
            loading: 'lazy',
            alt: ''
        }}
      </picture>
    </div>
  {%- endif -%}

  <div class="tavia-statement__inner">
    {%- if section.settings.eyebrow != blank -%}<p class="tavia-kicker tavia-statement__eyebrow">{{ section.settings.eyebrow | escape }}</p>{%- endif -%}
    <h2 class="tavia-statement__heading" id="TaviaStatementHeading-{{ section.id }}">{{ section.settings.heading | escape | newline_to_br }}</h2>
    <div class="tavia-statement__aside">
      {%- if section.settings.copy != blank -%}<p class="tavia-statement__copy">{{ section.settings.copy | escape | newline_to_br }}</p>{%- endif -%}
      {%- if section.settings.link_label != blank -%}
        <a class="tavia-underlined-link" href="{{ section.settings.link | default: routes.all_products_collection_url }}">{{ section.settings.link_label | escape }} ↗</a>
      {%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Tavia statement",
  "tag": "section",
  "class": "tavia-homepage-section",
  "settings": [
    { "type": "header", "content": "Background" },
    { "type": "image_picker", "id": "desktop_image", "label": "Desktop background image", "info": "Recommended canvas: 1440 × 680 px." },
    { "type": "image_picker", "id": "mobile_image", "label": "Mobile background image", "info": "Recommended canvas: 375 × 580 px. Falls back to the desktop image when empty." },
    { "type": "color", "id": "background_color", "label": "Background color", "default": "#ffffff" },
    { "type": "range", "id": "desktop_height", "label": "Desktop minimum height", "min": 480, "max": 900, "step": 20, "unit": "px", "default": 680 },
    { "type": "range", "id": "mobile_height", "label": "Mobile minimum height", "min": 420, "max": 800, "step": 20, "unit": "px", "default": 580 },
    { "type": "text", "id": "desktop_image_position", "label": "Desktop image position", "default": "50% 50%", "info": "CSS object position, for example: 50% 50%." },
    { "type": "text", "id": "mobile_image_position", "label": "Mobile image position", "default": "50% 50%", "info": "CSS object position, for example: 50% 35%." },
    { "type": "color", "id": "overlay_color", "label": "Overlay color", "default": "#000000" },
    { "type": "range", "id": "overlay_opacity", "label": "Overlay opacity", "min": 0, "max": 80, "step": 5, "unit": "%", "default": 0 },
    { "type": "header", "content": "Content" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "01 / The object" },
    { "type": "textarea", "id": "heading", "label": "Heading", "default": "One object. One continuous structure.\nEverything it needs, nothing it doesn’t." },
    { "type": "range", "id": "heading_width_desktop", "label": "Desktop heading width", "min": 420, "max": 900, "step": 20, "unit": "px", "default": 720 },
    { "type": "range", "id": "heading_width_mobile", "label": "Mobile heading width", "min": 220, "max": 360, "step": 10, "unit": "px", "default": 300 },
    { "type": "textarea", "id": "copy", "label": "Copy", "default": "Digitally designed and printed as one, so support, flex and airflow work together." },
    { "type": "text", "id": "link_label", "label": "Link label", "default": "Read the product note" },
    { "type": "url", "id": "link", "label": "Link" },
    { "type": "header", "content": "Text colors" },
    { "type": "color", "id": "label_color", "label": "Eyebrow color", "default": "#111111" },
    { "type": "color", "id": "heading_color", "label": "Heading color", "default": "#111111" },
    { "type": "color", "id": "copy_color", "label": "Copy color", "default": "#6f6f69" },
    { "type": "color", "id": "link_color", "label": "Link color", "default": "#111111" }
  ],
  "presets": [{ "name": "Tavia statement" }]
}
{% endschema %}
