{{ 'tavia-homepage.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign desktop_image = section.settings.desktop_image
  assign mobile_image = section.settings.mobile_image
  assign fallback_image = desktop_image | default: mobile_image

  assign desktop_ratio = desktop_image.aspect_ratio
  if desktop_ratio == blank
    assign desktop_ratio = mobile_image.aspect_ratio | default: 2.117647
  endif

  assign mobile_ratio = mobile_image.aspect_ratio | default: desktop_ratio
-%}

{%- style -%}
  #shopify-section-{{ section.id }} .tavia-statement {
    --tavia-statement-overlay-opacity: {{ section.settings.overlay_opacity | divided_by: 100.0 }};
    --tavia-statement-desktop-ratio: {{ desktop_ratio }};
    --tavia-statement-mobile-ratio: {{ mobile_ratio }};
    --tavia-statement-heading-width: {{ section.settings.heading_width_desktop | default: 720 }}px;
    --tavia-statement-mobile-heading-width: {{ section.settings.heading_width_mobile | default: 300 }}px;
  }
{%- endstyle -%}

<section class="tavia-home-section tavia-statement color-{{ section.settings.color_scheme }} gradient" aria-labelledby="TaviaStatementHeading-{{ section.id }}">
  {%- if fallback_image != blank -%}
    <div class="tavia-statement__media" aria-hidden="true">
      <picture class="tavia-statement__picture">
        {%- if mobile_image != blank -%}
          <source
            media="(max-width: 749px)"
            srcset="
              {{ mobile_image | image_url: width: 375 }} 375w,
              {{ mobile_image | image_url: width: 550 }} 550w,
              {{ mobile_image | image_url: width: 750 }} 750w,
              {{ mobile_image | image_url: width: 1000 }} 1000w
            "
            sizes="100vw"
          >
        {%- endif -%}
        {{
          fallback_image
          | image_url: width: 2400
          | image_tag:
            class: 'tavia-statement__image',
            widths: '750, 1100, 1600, 2000, 2400',
            sizes: '100vw',
            loading: 'lazy',
            alt: ''
        }}
      </picture>
    </div>
  {%- endif -%}

  <div class="tavia-statement__inner">
    {%- if section.settings.eyebrow != blank -%}<p class="tavia-kicker tavia-statement__eyebrow">{{ section.settings.eyebrow | escape }}</p>{%- endif -%}
    <div class="tavia-statement__content">
      <h2 class="tavia-statement__heading" id="TaviaStatementHeading-{{ section.id }}">{{ section.settings.heading | escape | newline_to_br }}</h2>
      {%- if section.settings.copy != blank -%}<p class="tavia-statement__copy">{{ section.settings.copy | escape | newline_to_br }}</p>{%- endif -%}
    </div>
    {%- if section.settings.link_label != blank -%}
      <a class="tavia-underlined-link tavia-statement__cta" href="{{ section.settings.link | default: routes.all_products_collection_url }}">{{ section.settings.link_label | escape }} ↗</a>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Tavia statement",
  "tag": "section",
  "class": "tavia-homepage-section",
  "settings": [
    { "type": "header", "content": "Background" },
    { "type": "image_picker", "id": "desktop_image", "label": "Desktop background image", "info": "Recommended canvas: 1440 × 680 px." },
    { "type": "image_picker", "id": "mobile_image", "label": "Mobile background image", "info": "Recommended canvas: 375 × 580 px. Falls back to the desktop image when empty." },
    { "type": "color_scheme", "id": "color_scheme", "label": "Color scheme", "default": "scheme-1" },
    { "type": "range", "id": "overlay_opacity", "label": "Overlay opacity", "min": 0, "max": 80, "step": 5, "unit": "%", "default": 0 },
    { "type": "header", "content": "Content" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "01 / The object" },
    { "type": "textarea", "id": "heading", "label": "Heading", "default": "One object. One continuous structure.\nEverything it needs, nothing it doesn’t." },
    { "type": "range", "id": "heading_width_desktop", "label": "Desktop heading width", "min": 420, "max": 900, "step": 20, "unit": "px", "default": 720 },
    { "type": "range", "id": "heading_width_mobile", "label": "Mobile heading width", "min": 220, "max": 360, "step": 10, "unit": "px", "default": 300 },
    { "type": "textarea", "id": "copy", "label": "Copy", "default": "Digitally designed and printed as one, so support, flex and airflow work together." },
    { "type": "text", "id": "link_label", "label": "Link label", "default": "Read the product note" },
    { "type": "url", "id": "link", "label": "Link" }
  ],
  "presets": [{ "name": "Tavia statement" }]
}
{% endschema %}
